# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API, ou botão "Connect" no topo do painel).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Pode ser a "anon key" (eyJ...) ou a "publishable key" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Opcional — integração com a AI Endurance (Partner API). Só o servidor lê estas duas:
# nunca use o prefixo VITE_ nelas (iria para o navegador). Veja "Integração AI Endurance" no README.
# AI_ENDURANCE_PARTNER_ID=seu-partner-id
# AI_ENDURANCE_API_KEY=sua-chave-de-parceiro
