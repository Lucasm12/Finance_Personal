# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API, ou botão "Connect" no topo do painel).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Pode ser a "anon key" (eyJ...) ou a "publishable key" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui
